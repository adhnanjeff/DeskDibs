# Make the `engines` range in package.json binding rather than advisory.
#
# Without this, npm treats engines as a suggestion and installs happily on a Node
# that cannot run the toolchain. The failure then surfaces much later and looks
# like something else entirely: on Node < 22.12, `npm run test` dies with fourteen
# ERR_REQUIRE_ESM errors out of jsdom's html-encoding-sniffer, because
# @exodus/bytes is ESM-only and `require(esm)` is unflagged only from 22.12
# onwards. That reads as a broken test suite, not as a wrong Node version, and
# costs an afternoon to trace.
#
# engine-strict turns it into one clear message at install time. The version
# itself lives in .nvmrc at the repo root, which CI reads too, so there is one
# source of truth for it.
engine-strict=true
